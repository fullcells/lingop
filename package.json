{
  "name": "lingop",
  "version": "0.7.9",
  "description": "Shared TypeScript code for Lingo web and native apps.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./utils/string": {
      "types": "./dist/utils/string.d.ts",
      "default": "./dist/utils/string.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./content/lingodex": {
      "types": "./dist/content/lingodex.d.ts",
      "default": "./dist/content/lingodex.js"
    },
    "./content/cl-learn-cefr": {
      "types": "./dist/content/cl-learn-cefr.d.ts",
      "default": "./dist/content/cl-learn-cefr.js"
    },
    "./content-reference": {
      "types": "./dist/core/content-reference.d.ts",
      "default": "./dist/core/content-reference.js"
    },
    "./core/language": {
      "types": "./dist/core/language/index.d.ts",
      "default": "./dist/core/language/index.js"
    },
    "./core/language/data": {
      "types": "./dist/core/language/data/index.d.ts",
      "default": "./dist/core/language/data/index.js"
    },
    "./binder": {
      "types": "./dist/core/binder/index.d.ts",
      "default": "./dist/core/binder/index.js"
    },
    "./annotation": {
      "types": "./dist/core/annotation/index.d.ts",
      "default": "./dist/core/annotation/index.js"
    },
    "./emojify": {
      "types": "./dist/core/emojify.d.ts",
      "default": "./dist/core/emojify.js"
    },
    "./language": {
      "types": "./dist/core/language/index.d.ts",
      "default": "./dist/core/language/index.js"
    },
    "./oat": {
      "types": "./dist/oat/index.d.ts",
      "default": "./dist/oat/index.js"
    },
    "./oat/react": {
      "types": "./dist/oat/react/index.d.ts",
      "default": "./dist/oat/react/index.js"
    },
    "./oat/build": {
      "types": "./dist/oat/build/index.d.ts",
      "default": "./dist/oat/build/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/next": {
      "types": "./dist/ui/next/index.d.ts",
      "default": "./dist/ui/next/index.js"
    },
    "./ui/next/camp-lingo-auth-form.css": "./src/ui/next/camp-lingo-auth-form.css",
    "./ui/react-native": {
      "types": "./dist/ui/react-native/index.d.ts",
      "default": "./dist/ui/react-native/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src/ui/next/camp-lingo-auth-form.css"
  ],
  "bin": {
    "oat-preflight": "./bin/oat-preflight.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate:oat-source-data": "node scripts/generate-oat-source-data.mjs",
    "build": "npm run clean && npm run generate:oat-source-data && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.13.11",
    "@types/react": "^19",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "dotenv": "^17.3.1",
    "jiti": "^2.5.1",
    "wink-lemmatizer": "^3.0.4"
  }
}
